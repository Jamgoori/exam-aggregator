NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# scripts/bulk-upload.mjs 전용. RLS를 우회하는 관리자 키이므로 절대 NEXT_PUBLIC_ 접두사를
# 붙이지 말고, 브라우저 코드에서 import하거나 git에 커밋하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# 회원가입 봇 방지용 Cloudflare Turnstile site key (dash.cloudflare.com > Turnstile).
# 비워두면 캡차 위젯이 렌더링되지 않고 서버에서도 캡차를 요구하지 않는다 (로컬 개발용 fallback).
# secret key는 여기 넣지 않고 Supabase 대시보드 Authentication > Attack Protection에 등록한다.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics 4 측정 ID (analytics.google.com > 관리 > 데이터 스트림). 비워두면 스크립트가 삽입되지 않는다.
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity 프로젝트 ID (clarity.microsoft.com > Setup). 비워두면 스크립트가 삽입되지 않는다.
NEXT_PUBLIC_CLARITY_ID=

# Storage(exam-papers 버킷) 파일을 매일 복제해두는 백업 대상 - Cloudflare R2.
# dash.cloudflare.com > R2 Object Storage에서 버킷을 만들고,
# Manage API Tokens > Create API Token(Object Read & Write, 해당 버킷으로 범위 제한 권장)으로 발급.
# R2_ACCOUNT_ID는 R2 개요 페이지 우측에 표시되는 Account ID.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=exam-papers-backup
