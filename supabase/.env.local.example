# `supabase functions serve --env-file supabase/.env.local` 에 넘기는 Edge 런타임 환경변수.
# 복사해서 supabase/.env.local 로 두고 값을 채운다(.env.local 은 루트 .gitignore 대상).
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY 는 `functions serve` 가 로컬
# 스택 값으로 자동 주입한다 — 여기 적지 말 것(적으면 프로덕션 키가 로컬 Edge 에 섞인다).
# 프로덕션 값은 `supabase secrets set` 으로만 올린다(apps/mobile/SETUP.md 5).

# ai-diagnose: Claude 호출 키. 계약 테스트·CBT·복습은 이 값을 쓰지 않으므로 진단 화면을
# 로컬에서 안 볼 거면 더미 문자열이어도 된다.
ANTHROPIC_API_KEY=

# ai-diagnose: 모델 ID 덮어쓰기(선택). 비우면 함수 기본값.
DIAGNOSIS_MODEL=
