# === 모노레포 루트 .gitignore ===
# 각 워크스페이스(apps/web, apps/mobile)는 자체 .gitignore 를 가진다.
# 여기서는 루트 레벨/횡단 관심사만 다룬다.

# dependencies (npm workspaces 는 루트로 호이스팅)
node_modules/
.pnp
.pnp.*

# turborepo
.turbo/

# supabase CLI 로컬 캐시
supabase/.temp/

# env (루트에 실수로 생기는 것 방지 — 앱별 env 는 앱 .gitignore 가 처리)
.env
.env.local
*.pem

# typescript 빌드 캐시
*.tsbuildinfo

# 로그/OS
*.log
npm-debug.log*
.DS_Store

# Claude Code 머신 로컬 설정 (세션마다 생성 — 커밋 금지)
.claude/settings.local.json
