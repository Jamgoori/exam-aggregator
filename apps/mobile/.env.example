# Supabase (웹과 동일한 프로젝트 값 사용 — publishable/anon 키는 앱 번들에 넣어도 안전)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_ANON_KEY

# Google 로그인 (Google Cloud Console)
# - WEB 클라이언트 ID: Supabase Auth > Providers > Google 에 등록한 것과 동일해야 함
# - IOS 클라이언트 ID: iOS 앱용
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Kakao 네이티브 앱 키는 코드가 아니라 app.json 플러그인에 넣는다(빌드 시 주입).

# Apple 로그인은 .env 값이 필요 없다(번들 ID + Supabase Auth > Providers > Apple 설정만).

# 웹 배포 도메인. 앱의 "이용약관 / 개인정보처리방침"이 이 주소의 /terms, /privacy 를
# 인앱 브라우저로 연다. 비어 있으면 두 문서가 안 열려서 스토어 심사에서 반려된다.
EXPO_PUBLIC_WEB_URL=https://gongmoa.kr
