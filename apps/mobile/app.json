{
  "expo": {
    "name": "공모아",
    "slug": "gongmoa-mobile",
    "scheme": "gongmoa",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gongmoa.app"
    },
    "android": {
      "package": "com.gongmoa.app"
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.PLACEHOLDER_REVERSED_CLIENT_ID"
        }
      ],
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "PLACEHOLDER_KAKAO_NATIVE_APP_KEY",
          "overrideKakaoSDKVersion": "2.20.0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
