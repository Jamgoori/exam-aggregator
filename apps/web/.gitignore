# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# 로컬 벌크 업로드 대기/처리 폴더 (실제 저작권 있는 PDF는 git에 올리지 않음)
/uploads/*
!/uploads/.gitkeep
/src/testpaper/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# 해설 백업 JSON (deploy-law-explanations.mjs가 생성 — 해설 본문 포함이라 커밋 금지)
# + DB 전체 덤프(backup-db.mjs 기본 출력). paper_answers 정답표 전량과
#   comments.password_hash·profiles 가 들어 있어 커밋되면 히스토리에서 되살아난다.
/backups/
db-backup-*.json

# Claude Code 머신 로컬 설정 (배치 루틴 환경이 세션마다 생성 — 커밋 금지)
.claude/settings.local.json

# 크롭 회귀 검사·백필의 로컬 작업물 (리포트 JSON, 임시 스크립트·이미지 — 커밋 금지)
crop-regression-report*.json
/scripts/tmp/
