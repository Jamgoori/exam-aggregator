{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@gongmoa/core": ["../../packages/core/src/index.ts"],
      "@gongmoa/core/*": ["../../packages/core/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    // TypeScript 의 와일드카드(`**`)는 이름이 `.` 으로 시작하는 디렉터리를 건너뛴다 —
    // 위의 `**/*.ts` 만으로는 `src/app/.well-known/**` 의 라우트 핸들러가 타입검사에서
    // 통째로 빠진다(ESLint 는 잡지만 tsc 는 못 본다). 유니버설 링크 파일 두 개가
    // 거기 있으므로 경로를 명시한다.
    "src/app/.well-known/**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
