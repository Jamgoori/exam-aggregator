NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# scripts/bulk-upload.mjs 전용. RLS를 우회하는 관리자 키이므로 절대 NEXT_PUBLIC_ 접두사를
# 붙이지 말고, 브라우저 코드에서 import하거나 git에 커밋하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# ── 결제 (토스페이먼츠) ────────────────────────────────────────────────────────
# 두 값이 모두 있어야 결제 기능이 켜진다(lib/toss.ts 의 isTossConfigured). 하나만
# 넣으면 결제창은 뜨는데 승인이 실패하는 반쪽 상태가 되므로 항상 같이 넣을 것.
# 비워두면 요금제 페이지의 버튼이 예전처럼 "준비 중"을 안내한다.
#
# 계약 전에도 개발·테스트가 가능하다: developers.tosspayments.com 에 가입하면
# 사업자등록 없이 테스트 키가 바로 발급된다(test_ck_ / test_sk_ 로 시작).
# 심사가 끝나면 라이브 키(live_ck_ / live_sk_)로 바꿔 끼우기만 하면 된다.
#
# 시크릿 키는 이 키 하나로 임의의 결제를 승인·취소할 수 있다. 절대 NEXT_PUBLIC_
# 접두사를 붙이지 말고, 브라우저 코드에서 import 하거나 git 에 커밋하지 말 것.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
#
# 웹훅 등록(결제 오픈 시 필수): 토스 개발자센터 > 웹훅 >
#   https://gongmoa.kr/api/payments/toss/webhook  / 이벤트: PAYMENT_STATUS_CHANGED
# 승인 직후 브라우저가 닫혀 successUrl 리다이렉트가 유실돼도 결제가 반영되게 하는
# 안전망이다. 등록하지 않으면 "돈은 빠졌는데 멤버십이 안 켜진" 주문이 생길 수 있다.

# ── AI 약점 진단 (맞춤 극복법) ────────────────────────────────────────────────
# 맞춤 극복법을 만드는 데만 쓰는 키다. 기본 경로는 Message Batches API(비동기·요금 절반,
# lib/diagnosis-batch.ts): 진단받기를 누르면 배치에 실리고, 결과는 매시간 도는 크론
# (/api/cron/diagnosis)이나 진단 페이지 진입이 수거해 채운다. 이 기능 전용 키 —
# 일반 ANTHROPIC_API_KEY 가 아니다.
# 레포에 ANTHROPIC_API_KEY 를 읽는 다른 스크립트가 있는데(scripts/extract-answer-keys.mjs,
# 정답 추출 배치), 변수명을 같이 쓰면 여기 등록한 키가 그쪽에서도 그대로 읽혀 의도치
# 않은 곳에 요금이 나간다. 그래서 변수명을 분리했다 — 반드시 이 이름 그대로 쓸 것.
# 비워두면 극복법 생성이 조용히 건너뛰어지고(그래프·오답노트는 그대로 동작), 기존
# 배치 생성기(scripts/next-diagnosis.mjs, 실비 없음)가 나중에 채운다.
ANTHROPIC_DIAGNOSIS_API_KEY=
# 생성에 쓸 모델(기본 claude-opus-5). 바꿀 때만 넣는다.
ANTHROPIC_DIAGNOSIS_MODEL=
# 1 이면 배치 대신 예전처럼 누른 그 자리에서 만든다(Messages API, 개념마다 1콜을 동시에). 요금이 2배이고
# 서버리스 함수가 모델 응답을 기다려야 하므로, 운영 중 결과를 바로 확인해야 할 때만
# 잠깐 켜는 탈출구다. 평소에는 비워둘 것.
ANTHROPIC_DIAGNOSIS_SYNC=

# Google Analytics 4 측정 ID (analytics.google.com > 관리 > 데이터 스트림). 비워두면 스크립트가 삽입되지 않는다.
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity 프로젝트 ID (clarity.microsoft.com > Setup). 비워두면 스크립트가 삽입되지 않는다.
NEXT_PUBLIC_CLARITY_ID=

# 검색엔진 사이트 소유확인용 메타 태그 값(content= 안의 문자열만). 각 웹마스터
# 도구에서 "HTML 태그" 방식을 고르면 알려준다. 비워두면 태그가 붙지 않는다.
# 소유확인이 끝난 뒤에도 값은 지우지 말 것 — 태그가 사라지면 소유권이 해제된다.
#   구글: search.google.com/search-console > 속성 추가 > HTML 태그
GOOGLE_SITE_VERIFICATION=
#   빙: bing.com/webmasters > 사이트 추가 > HTML 메타 태그
BING_SITE_VERIFICATION=
#   네이버(searchadvisor.naver.com)는 값이 app/layout.tsx 에 상수로 들어 있어서
#   따로 설정하지 않아도 된다. 도메인을 옮겨 값이 바뀔 때만 여기서 덮어쓴다.
NAVER_SITE_VERIFICATION=

# ── 크론 워밍업 보호 ──────────────────────────────────────────────────────────
# /api/cron/warm 은 Supabase 자동 일시정지를 막고 홈 캐시를 데우는 주소다(vercel.json
# 의 crons). 비워두면 **무인증 공개**라 아무나 반복 호출해 함수 실행·Supabase 쿼터를
# 태울 수 있다(새는 데이터는 없고 비용 문제다).
# /api/cron/diagnosis(진단 배치 제출·수거)는 이 값이 **없으면 아예 503 으로 거절한다** —
# 그 주소는 두드리면 실API 요금이 나가는 배치를 제출하므로 무인증으로 열어둘 수 없다.
# 즉, 값을 넣지 않으면 배치 수거가 크론으로는 돌지 않는다(진단 페이지 진입 수거만 남는다). 아무 긴 난수 문자열이면 된다:
#   openssl rand -hex 32
# Vercel 프로젝트 환경변수에 넣어 두면 Vercel 크론이 Authorization 헤더에 자동으로
# 실어 보내므로 크론 설정은 따로 손댈 게 없다.
CRON_SECRET=

# ── 토스 웹훅 발신 IP 제한(선택) ──────────────────────────────────────────────
# 토스 개발자센터가 공지하는 웹훅 발신 IP 를 쉼표로 나열하면 그 밖의 요청은 토스에
# 되묻지도 않는다. 비워두면 IP 로는 거르지 않는다(형식 검사 + 유량 제한은 그대로
# 동작한다). 토스가 IP 를 바꾸면 웹훅이 조용히 죽으므로 넣었다면 공지를 따라갈 것.
TOSS_WEBHOOK_IPS=

# ── 해외 IP 차단(선택) ────────────────────────────────────────────────────────
# 기본은 꺼짐. 켜려면 GEO_BLOCK=on. 자세한 내용은 docs/agents/geo-block.md.
# BYPASS 토큰은 해외에서 확인할 때(운영자·모니터링·GitHub Actions 도메인 점검)
# 쓰는 값이라 CRON_SECRET 처럼 추측 불가능해야 한다.
GEO_BLOCK=
GEO_BLOCK_COUNTRIES=
GEO_BLOCK_BYPASS_TOKEN=
